# velio-ww marketing site — velio.watch (apex is primary)
# Apex serves port 3004; www.velio.watch redirects to apex.
# To apply: caddy reload --config /home/admin/caddy-config.json

velio.watch {
	reverse_proxy localhost:3004
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
		-Server
	}
}

www.velio.watch {
	redir https://velio.watch{uri} permanent
}
